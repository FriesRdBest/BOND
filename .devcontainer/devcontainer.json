{
  "name": "BOND development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8501, 8000],
  "portsAttributes": {
    "8501": {
      "label": "BOND workspace",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "BOND API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install uv==0.13.1 && uv sync --locked"
}
